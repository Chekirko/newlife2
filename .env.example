# Public Sanity identifiers (required to build the existing site).
NEXT_PUBLIC_SANITY_PROJECT_ID=n4j5141g
NEXT_PUBLIC_SANITY_DATASET=production

# Optional public API date (the code already defaults to this version).
# NEXT_PUBLIC_SANITY_API_VERSION=2026-02-02
# Optional full canonical origin; leave commented to use the current fallback.
# NEXT_PUBLIC_SITE_URL=https://example.org

# Server-only helpers. Not required for the public site's build.
# Sanity write token: only for explicitly authorized seed operations.
SANITY_API_WRITE_TOKEN=
# Optional Sanity CLI authentication; never expose through NEXT_PUBLIC_.
SANITY_AUTH_TOKEN=
# Signed CMS cache invalidation; same secret in Sanity webhook settings.
SANITY_REVALIDATE_SECRET=
# Live video detection also needs a channel ID in Studio siteSettings.
YOUTUBE_API_KEY=

# Contact form — server-only. Add actual values in .env.local / Vercel Settings.
RESEND_API_KEY=
# Bare email address on a domain verified in Resend (no display name).
CONTACT_FROM_EMAIL=
# Optional: empty means the current siteSettings.email from Sanity.
CONTACT_TO_EMAIL=
# Upstash Redis REST credentials; required for the shared spam limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
